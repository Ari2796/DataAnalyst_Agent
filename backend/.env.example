# ==============================================================================
# AI-Powered E-Commerce Data Analyst Agent - Environment Configuration Template
# ==============================================================================

# LLM Configuration (Compatible with OpenAI Chat Completions API)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-provider-base-url/v1
LLM_MODEL=your_model_name

# Server Settings
BACKEND_PORT=8001
BACKEND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Data & Agent Safeguards (Token & Cost Controls)
MAX_UPLOAD_SIZE_MB=20
MAX_TOOL_ITERATIONS=3       # Max agent reasoning loops (reduces token roundtrips)
MAX_OUTPUT_TOKENS=350       # Caps maximum generated output tokens per response
MAX_HISTORY_TURNS=3         # Retains only the most recent conversation context
DEFAULT_SAMPLE_ROWS=5
